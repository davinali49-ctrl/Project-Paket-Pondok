<%- include('../partials/head', { judul: 'Data Santri' }) %>
<%- include('../partials/navbar') %>

<div class="container">
    <% if (msg) { %>
        <div class="alert alert-success"><%= msg %></div>
    <% } %>
    <% if (error) { %>
        <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="card">
        <div class="card-header">
            <h3>Daftar Santri</h3>
            <a href="/santri/tambah" class="btn btn-primary">+ Tambah Santri</a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>No</th>
                    <th>Nama Santri</th>
                    <th>Asrama</th>
                    <th>Jumlah Paket</th>
                    <th>Sudah Diambil</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (santri.length > 0) { %>
                    <% santri.forEach((s, i) => { %>
                        <tr>
                            <td><%= i + 1 %></td>
                            <td><strong><%= s.nama_santri %></strong></td>
                            <td><%= s.nama_asrama %></td>
                            <td><%= s.jumlah_paket %></td>
                            <td><%= s.paket_diambil %></td>
                            <td>
                                <div class="actions">
                                    <a href="/santri/<%= s.id_santri %>/edit" class="btn btn-warning btn-sm">Edit</a>
                                    <form method="POST" action="/santri/<%= s.id_santri %>/hapus" onsubmit="return confirm('Hapus santri <%= s.nama_santri %>?');">
                                        <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="6" style="text-align: center; color: #888;">Belum ada data santri.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

</body>
</html>