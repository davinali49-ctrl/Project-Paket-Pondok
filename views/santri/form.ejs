<%- include('../partials/head', { judul: mode === 'tambah' ? 'Tambah Santri' : 'Edit Santri' }) %>
<%- include('../partials/navbar') %>

<div class="container">
    <div class="card">
        <div class="card-header">
            <h3><%= mode === 'tambah' ? 'Tambah Santri' : 'Edit Santri' %></h3>
            <a href="/santri" class="btn btn-secondary">← Kembali</a>
        </div>

        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <% const isi = nilai || santri || {}; %>

        <form method="POST" action="<%= mode === 'tambah' ? '/santri' : '/santri/' + santri.id_santri %>">
            <div class="form-group">
                <label for="nama_santri">Nama Santri <span style="color:#B23A3A">*</span></label>
                <input type="text" id="nama_santri" name="nama_santri" value="<%= isi.nama_santri || '' %>" required>
            </div>
            <div class="form-group">
                <label for="asrama">Asrama <span style="color:#B23A3A">*</span></label>
                <select id="asrama" name="asrama" required>
                    <option value="">— Pilih Asrama —</option>
                    <% daftarAsrama.forEach(a => { %>
                        <option value="<%= a.id_asrama %>" <%= String(isi.asrama || isi.id_asrama) === String(a.id_asrama) ? 'selected' : '' %>>
                            <%= a.nama_asrama %>
                        </option>
                    <% }) %>
                </select>
            </div>
            <div class="form-group">
                <label for="no_hp">No. HP</label>
                <input type="text" id="no_hp" name="no_hp" value="<%= isi.no_hp || '' %>" placeholder="08xxxxxxxxxx">
            </div>
            <div class="form-group">
                <label for="jenis_kelamin">Jenis Kelamin</label>
                <select id="jenis_kelamin" name="jenis_kelamin">
                    <option value="">— Pilih —</option>
                    <option value="L" <%= isi.jenis_kelamin === 'L' ? 'selected' : '' %>>Laki-laki</option>
                    <option value="P" <%= isi.jenis_kelamin === 'P' ? 'selected' : '' %>>Perempuan</option>
                </select>
            </div>
            <div class="form-group">
                <label for="keterangan">Keterangan</label>
                <textarea id="keterangan" name="keterangan" rows="3"><%= isi.keterangan || '' %></textarea>
            </div>

            <div class="actions" style="margin-top: 10px;">
                <button type="submit" class="btn btn-primary">Simpan</button>
                <a href="/santri" class="btn btn-secondary">Batal</a>
            </div>
        </form>
    </div>
</div>

</body>
</html>