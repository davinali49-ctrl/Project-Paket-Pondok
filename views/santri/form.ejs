<%- include('../partials/head', { judul: mode === 'tambah' ? 'Tambah Santri' : 'Edit Santri' }) %>
<%- include('../partials/navbar') %>

<div class="container">
    <div class="card">
        <div class="card-header">
            <h3><%= mode === 'tambah' ? 'Tambah Santri' : 'Edit Santri' %></h3>
            <a href="/santri" class="btn btn-secondary">← Kembali</a>
        </div>

        <% if (error) { %>
            <div class="alert alert-error"><%= error %></div>
        <% } %>

        <% const isi = nilai || santri || {}; %>

        <form method="POST" action="<%= mode === 'tambah' ? '/santri' : '/santri/' + santri.id_santri %>">
            <div class="form-group">
                <label for="nama_santri">Nama Santri <span style="color:#B23A3A">*</span></label>
                <input type="text" id="nama_santri" name="nama_santri" value="<%= isi.nama_santri || '' %>" required>
            </div>
            <div class="form-group">
                <label for="asrama">Asrama <span style="color:#B23A3A">*</span></label>
                <select id="asrama" name="asrama" required>
                    <option value="">— Pilih Asrama —</option>
                    <% daftarAsrama.forEach(a => { %>
                        <option value="<%= a.id_asrama %>" <%= String(isi.asrama) === String(a.id_asrama) ? 'selected' : '' %>>
                            <%= a.nama_asrama %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <div class="actions" style="margin-top: 10px;">
                <button type="submit" class="btn btn-primary">Simpan</button>
                <a href="/santri" class="btn btn-secondary">Batal</a>
            </div>
        </form>
    </div>
</div>

</body>
</html>