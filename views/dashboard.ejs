<%- include('partials/head', { judul: 'Dashboard' }) %>
<%- include('partials/navbar') %>

<div class="container">
    <% if (msg) { %>
        <div class="alert alert-success"><%= msg %></div>
    <% } %>

    <div class="card">
        <h2>Selamat Datang, <%= nama %>! 👋</h2>
        <p>Anda login sebagai Petugas. Kelola data kedatangan dan pengambilan paket santri di bawah ini.</p>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Daftar Paket Masuk</h3>
            <a href="/paket/tambah" class="btn btn-primary">+ Tambah Paket</a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>No. Resi</th>
                    <th>Nama Tertera</th>
                    <th>Santri Pemilik</th>
                    <th>Ekspedisi</th>
                    <th>Tanggal Masuk</th>
                    <th>Status</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (paket && paket.length > 0) { %>
                    <% paket.forEach(item => { %>
                        <tr>
                            <td><strong><%= item.no_resi ? item.no_resi : '-' %></strong></td>
                            <td><%= item.nama_pada_paket %></td>
                            <td>
                                <%= item.nama_santri ? item.nama_santri : 'Belum Terhubung' %>
                            </td>
                            <td><%= item.nama_ekspedisi %></td>
                            <td><%= formatTanggalWaktu(item.tanggal_diterima) %></td>
                            <td>
                                <% if (item.status_paket === 'SUDAH DIAMBIL') { %>
                                    <span class="badge badge-success">SUDAH DIAMBIL</span>
                                    <div class="text-muted" style="font-size: 12px; margin-top: 4px;">
                                        <%= item.nama_pengambil %> • <%= item.jenis_pengambilan %>
                                        <br><%= formatTanggalWaktu(item.tanggal_diambil) %>
                                    </div>
                                <% } else { %>
                                    <span class="badge badge-warning">BELUM DIAMBIL</span>
                                <% } %>
                            </td>
                            <td>
                                <div class="actions">
                                    <a href="/paket/<%= item.id_paket %>/edit" class="btn btn-warning btn-sm">Edit</a>
                                    <% if (item.status_paket === 'BELUM DIAMBIL') { %>
                                        <button type="button" class="btn btn-success btn-sm" onclick="bukaModal(<%= item.id_paket %>)">Tandai Diambil</button>
                                    <% } %>
                                    <form method="POST" action="/paket/<%= item.id_paket %>/hapus" onsubmit="return confirm('Hapus paket <%= item.no_resi ? item.no_resi : item.id_paket %>?');">
                                        <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="7" style="text-align: center; color: #888;">Belum ada data paket di database.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Tandai Paket Sudah Diambil -->
<div class="modal-overlay" id="modal-ambil" style="display: none;">
    <div class="modal">
        <h3>Tandai Paket Sudah Diambil</h3>
        <form method="POST" id="form-ambil" action="">
            <div class="form-group">
                <label for="nama_pengambil">Nama Pengambil</label>
                <input type="text" id="nama_pengambil" name="nama_pengambil" required placeholder="Nama yang mengambil paket">
            </div>
            <div class="form-group">
                <label for="jenis_pengambilan">Jenis Pengambilan</label>
                <select id="jenis_pengambilan" name="jenis_pengambilan" required>
                    <option value="AMBIL_SENDIRI">Diambil Sendiri</option>
                    <option value="DIWAKILKAN">Diwakilkan</option>
                </select>
            </div>
            <div class="actions" style="justify-content: flex-end;">
                <button type="button" class="btn btn-secondary" onclick="tutupModal()">Batal</button>
                <button type="submit" class="btn btn-success">Simpan</button>
            </div>
        </form>
    </div>
</div>

<script>
    function bukaModal(idPaket) {
        document.getElementById('form-ambil').action = '/paket/' + idPaket + '/ambil';
        document.getElementById('nama_pengambil').value = '';
        document.getElementById('jenis_pengambilan').value = 'AMBIL_SENDIRI';
        document.getElementById('modal-ambil').style.display = 'flex';
    }
    function tutupModal() {
        document.getElementById('modal-ambil').style.display = 'none';
    }
</script>

</body>
</html>