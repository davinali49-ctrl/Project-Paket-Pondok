<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Sistem Pengelolaan Paket Santri</title>

    <style>
        /* ---- Palet Warna (The Green Palette) ---- */
        :root {
            --emerald: #14452F;
            --green: #23884D;
            --gold: #D4AF37;
            --body-bg: #F4F7F4;
            --card-bg: #FFFFFF;
            --text: #2B2B2B;
            --muted: #6C7A72;
            --border: #DCE5DE;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--body-bg);
            color: var(--text);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }
        .login-card {
            background: var(--card-bg);
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 6px 20px rgba(20, 69, 47, 0.15);
            width: 100%;
            max-width: 360px;
            border-top: 4px solid var(--emerald);
        }
        .login-card h2 {
            margin-top: 0;
            margin-bottom: 6px;
            text-align: center;
            color: var(--emerald);
        }
        .login-subtitle {
            text-align: center;
            color: var(--muted);
            font-size: 13px;
            margin: 0 0 20px;
        }
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #45534B;
        }
        .form-group input {
            width: 100%;
            padding: 10px;
            border: 1px solid var(--border);
            border-radius: 5px;
            box-sizing: border-box;
            color: var(--text);
            font-family: inherit;
        }
        .form-group input:focus {
            outline: none;
            border-color: var(--green);
            box-shadow: 0 0 0 3px rgba(35, 136, 77, 0.15);
        }
        .btn-login {
            width: 100%;
            padding: 10px;
            background-color: var(--green);
            border: none;
            color: white;
            font-weight: bold;
            border-radius: 5px;
            cursor: pointer;
            font-family: inherit;
            font-size: 14px;
        }
        .btn-login:hover {
            background-color: var(--emerald);
        }
        .alert-error {
            background-color: #f8d7da;
            color: #842029;
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 15px;
            font-size: 14px;
            text-align: center;
        }
    </style>
</head>
<body>

<div class="login-card">
    <h2>Login Petugas</h2>
    <p class="login-subtitle">Sistem Pengelolaan Paket Santri</p>

    <% if (error) { %>
        <div class="alert-error"><%= error === '2' ? 'Silakan login terlebih dahulu.' : 'Username atau password salah!' %></div>
    <% } %>

    <form action="/login" method="POST">
        <div class="form-group">
            <label for="username">Username</label>
            <input type="text" id="username" name="username" required placeholder="Masukkan username">
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required placeholder="Masukkan password">
        </div>
        <button type="submit" class="btn-login">Masuk</button>
    </form>
</div>

</body>
</html>